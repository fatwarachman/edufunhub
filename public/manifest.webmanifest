{
    "id": "/dashboard",
    "name": "EduFunHub",
    "short_name": "EduFunHub",
    "description": "Belajar sambil bermain: game kuis edukasi untuk TK sampai SMA.",
    "lang": "id",
    "start_url": "/dashboard?source=pwa",
    "scope": "/",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui"],
    "orientation": "any",
    "background_color": "#fffaf0",
    "theme_color": "#ffd93d",
    "categories": ["education", "games", "kids"],
    "prefer_related_applications": false,
    "related_applications": [
        { "platform": "play", "id": "com.edufunhub.app", "url": "https://play.google.com/store/apps/details?id=com.edufunhub.app" }
    ],
    "icons": [
        { "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/pwa-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Portal", "url": "/portal?source=pwa", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] },
        { "name": "Daftar Game", "url": "/gamelist?source=pwa", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192" }] }
    ]
}
