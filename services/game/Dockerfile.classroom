FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go test ./internal/classroom/... ./internal/classroomsrv/... ./internal/auth/... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/classroom ./cmd/classroom

FROM alpine:3.20
RUN adduser -D -H -u 10001 classroom && apk add --no-cache wget
USER classroom
COPY --from=build /out/classroom /usr/local/bin/classroom
EXPOSE 8092
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8092/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/classroom"]
