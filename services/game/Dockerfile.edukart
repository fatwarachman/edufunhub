FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go test ./internal/edukart/... ./internal/edukartsrv/... ./internal/auth/... ./internal/questions/... ./internal/points/... && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/edukart ./cmd/edukart

FROM alpine:3.20
RUN adduser -D -H -u 10001 edukart && apk add --no-cache wget
USER edukart
COPY --from=build /out/edukart /usr/local/bin/edukart
EXPOSE 8093
HEALTHCHECK --interval=10s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:8093/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/edukart"]
